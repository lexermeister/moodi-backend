APP_ENV=development
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081","http://localhost:4174","http://127.0.0.1:4174"]
LOG_LEVEL=INFO
RECORDINGS_DIR=./data/recordings
MAX_UPLOAD_MB=100
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_ROLE_ATTRIBUTION_MODEL=gpt-4o-mini
OPENAI_INSIGHTS_MODEL=gpt-6-luna
OPENAI_INSIGHTS_REASONING_EFFORT=none

